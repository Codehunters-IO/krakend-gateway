{
  "enabled": true,
  "jwks_url": "http://keycloak:8080/realms/codehunters/protocol/openid-connect/certs",
  "issuer": "http://keycloak:8080/realms/codehunters",
  "cache_ttl_minutes": 60,
  "claims_to_headers": [
    { "claim": "preferred_username", "header": "x-username" },
    { "claim": "realm_access.roles", "header": "x-user-roles" },
    { "claim": "sub", "header": "x-user-id" }
  ],
  "skip_paths": [
    "/public/*",
    "/codehunters-ms-auth/api/v1/login",
    "/codehunters-ms-auth/api/v1/accounts/register",
    "/codehunters-ms-auth/api/v1/token/refresh",
    "/codehunters-ms-auth/api/v1/verify/email",
    "/codehunters-ms-auth/api/v1/forgot-password",
    "/codehunters-ms-auth/api/v1/reset-password",
    "/codehunters-ms-auth/api/v1/document/validate",
    "/codehunters-ms-auth/v1/api-docs",
    "/codehunters-ms-auth/swagger-ui.html",
    "/codehunters-ms-auth/swagger-ui",
    "/codehunters-ms-auth/actuator/health",
    "/codehunters-ms-file-share/v1/api-docs",
    "/codehunters-ms-file-share/swagger-ui.html",
    "/codehunters-ms-file-share/swagger-ui",
    "/codehunters-ms-file-share/actuator/health",
    "/codehunters-ms-managment/v1/api-docs",
    "/codehunters-ms-managment/swagger-ui.html",
    "/codehunters-ms-managment/swagger-ui",
    "/codehunters-ms-managment/actuator/health",
    "/codehunters-ms-payment/v1/api-docs",
    "/codehunters-ms-payment/swagger-ui.html",
    "/codehunters-ms-payment/swagger-ui",
    "/codehunters-ms-payment/actuator/health",
    "/codehunters-ms-raffles/v1/api-docs",
    "/codehunters-ms-raffles/swagger-ui.html",
    "/codehunters-ms-raffles/swagger-ui",
    "/codehunters-ms-raffles/actuator/health",
    "/codehunters-ms-notifications/v1/api-docs",
    "/codehunters-ms-notifications/swagger-ui.html",
    "/codehunters-ms-notifications/swagger-ui",
    "/codehunters-ms-notifications/actuator/health",
    "/codehunters-ms-payment/api/v1/webhooks/smartfastpay",
    "/codehunters-ms-payment/api/v1/webhooks/tumipay",
    "/codehunters-ms-payment/api/v1/webhooks/mock",
    "/codehunters-ms-managment/api/v1/public/raffles"
  ],
  "add_ip_header": true,
  "ip_header_name": "x-ip"
}
