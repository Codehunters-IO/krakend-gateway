{
  "enabled": true,
  "jwks_url": "http://host.docker.internal:8083/realms/forgeos/protocol/openid-connect/certs",
  "issuer": "http://localhost:8083/realms/forgeos",
  "cache_ttl_minutes": 60,
  "claims_to_headers": [
    { "claim": "preferred_username", "header": "x-username" },
    { "claim": "realm_access.roles", "header": "x-user-roles" },
    { "claim": "sub", "header": "x-user-id" },
    { "claim": "organizationId", "header": "X-Organization-Id" },
    { "claim": "slug", "header": "x-org-slug" }
  ],
  "skip_paths": [
    "/public/*"
  ],
  "add_ip_header": true,
  "ip_header_name": "x-ip",
  "required_claims": ["sub", "organizationId"],
  "roles_claim": "realm_access.roles",
  "required_roles": [],
  "introspection_enabled": false,
  "introspection_url": "",
  "introspection_client_id": "",
  "introspection_cache_ttl_seconds": 30
}
