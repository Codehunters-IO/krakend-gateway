{
  "endpoints": [
    {
      "path": "/auth/login/{provider}",
      "method": "GET",
      "auth": "public",
      "url_pattern": "/auth/login/{provider}",
      "output_encoding": "no-op",
      "encoding": "no-op",
      "host_env": "AUTH_BFF_HOST",
      "host_default": "http://host.docker.internal:8086",
      "disable_host_sanitize": false,
      "input_headers": [
        "Accept",
        "Content-Type",
        "Cookie",
        "Traceparent",
        "Tracestate",
        "X-Traceparent"
      ],
      "input_query_strings": [],
      "timeout": "",
      "rate_limit": {
        "max_rate": 20,
        "client_max_rate": 5,
        "strategy": "ip"
      },
      "roles": null
    },
    {
      "path": "/auth/callback",
      "method": "GET",
      "auth": "public",
      "url_pattern": "/auth/callback",
