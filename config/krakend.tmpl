{
  "$schema": "https://www.krakend.io/schema/krakend.json",
  "version": 3,
  "name": "{{ .service.name }}",
  "port": {{ .service.port }},
  "timeout": "{{ .service.timeout }}",
  "cache_ttl": "{{ .service.cache_ttl }}",
  {{- if not .tls.disabled }}
  "tls": {
    "keys": {{ marshal .tls.keys }}
    {{- if .tls.min_version }},
    "min_version": "{{ .tls.min_version }}"
    {{- end }}
    {{- if .tls.max_version }},
    "max_version": "{{ .tls.max_version }}"
    {{- end }}
    {{- if .tls.enable_mtls }},
    "enable_mtls": {{ .tls.enable_mtls }}
    {{- end }}
    {{- if .tls.disable_system_ca_pool }},
    "disable_system_ca_pool": {{ .tls.disable_system_ca_pool }}
    {{- end }}
    {{- if .tls.ca_certs }},
    "ca_certs": {{ marshal .tls.ca_certs }}
    {{- end }}
  },
  {{- end }}
  "client_tls": {{ marshal .client_tls }},
  "plugin": {
    "pattern": ".so",
    "folder": "/opt/krakend/plugins/"
  },
  "extra_config": {
    "plugin/http-server": {
      "name": [
        {{- if .gateway_timeout.enabled }}
        "krakend-gateway-timeout"{{ if or .accept_language.enabled .trace_context.enabled .ip_resolver.enabled .jwt.enabled }},{{ end }}
        {{- end }}
        {{- if .accept_language.enabled }}
        "krakend-accept-language"{{ if or .trace_context.enabled .ip_resolver.enabled .jwt.enabled }},{{ end }}
        {{- end }}
        {{- if .trace_context.enabled }}
        "krakend-trace-context"{{ if or .ip_resolver.enabled .jwt.enabled }},{{ end }}
        {{- end }}
        {{- if .ip_resolver.enabled }}
        "krakend-ip-resolver"{{ if .jwt.enabled }},{{ end }}
        {{- end }}
        {{- if .jwt.enabled }}
        "krakend-jwt-headers"
        {{- end }}
      ]
      {{- if or .gateway_timeout.enabled .accept_language.enabled .ip_resolver.enabled .jwt.enabled }},{{ end }}
      {{- if .gateway_timeout.enabled }}
      "krakend-gateway-timeout": {
        "trigger_status": {{ .gateway_timeout.trigger_status }},
        "timeout_status": {{ .gateway_timeout.timeout_status }},
        "min_elapsed": "{{ env "GATEWAY_TIMEOUT_MIN_ELAPSED" | default .gateway_timeout.min_elapsed }}"
      }{{ if or .accept_language.enabled .ip_resolver.enabled .jwt.enabled }},{{ end }}
      {{- end }}
      {{- if .accept_language.enabled }}
      "krakend-accept-language": {
        "default_value": "{{ .accept_language.default_value }}"
      }{{ if or .ip_resolver.enabled .jwt.enabled }},{{ end }}
      {{- end }}
      {{- if .ip_resolver.enabled }}
      "krakend-ip-resolver": {
        "api_base_url": "{{ .ip_resolver.api_base_url }}",
        "cache_ttl_minutes": {{ .ip_resolver.cache_ttl_minutes }},
        "skip_paths": {{ marshal .ip_resolver.skip_paths }}
      }{{ if .jwt.enabled }},{{ end }}
      {{- end }}
      {{- if .jwt.enabled }}
      "krakend-jwt-headers": {
        "jwks_url": "{{ env "KEYCLOAK_JWKS_URL" | default .jwt.jwks_url }}",
        "issuer": "{{ env "KEYCLOAK_ISSUER" | default .jwt.issuer }}",
        "cache_ttl_minutes": {{ .jwt.cache_ttl_minutes }},
        "claims_to_headers": {{ marshal .jwt.claims_to_headers }},
        "skip_paths": {{ marshal .jwt.skip_paths }},
        "required_claims": {{ marshal .jwt.required_claims }},
        "roles_claim": "{{ .jwt.roles_claim }}",
        "required_roles": {{ marshal .jwt.required_roles }},
        "add_ip_header": {{ .jwt.add_ip_header }},
        "ip_header_name": "{{ .jwt.ip_header_name }}",
        "introspection_enabled": {{ .jwt.introspection_enabled }},
        "introspection_url": "{{ .jwt.introspection_url }}",
        "introspection_client_id": "{{ .jwt.introspection_client_id }}",
        "introspection_client_secret": "{{ env "JWT_INTROSPECTION_CLIENT_SECRET" | default "" }}",
        "introspection_cache_ttl_seconds": {{ .jwt.introspection_cache_ttl_seconds }}
      }
      {{- end }}
    },
    "security/cors": {
      "allow_origins": {{ marshal .cors.allow_origins }},
      "allow_methods": {{ marshal .cors.allow_methods }},
      "allow_headers": {{ marshal .cors.allow_headers }},
      "expose_headers": {{ marshal .cors.expose_headers }},
      "max_age": "{{ .cors.max_age }}",
      "allow_credentials": {{ marshal .cors.allow_credentials }}
    },
    "qos/ratelimit/service": {
      "max_rate": {{ .rate_limit.service_max_rate }},
      "client_max_rate": {{ .rate_limit.service_client_max_rate }},
      "strategy": "{{ .rate_limit.strategy }}"
    },
    "telemetry/gologging": {
      "level": "{{ env "LOG_LEVEL" | default .logging.level }}",
      "prefix": "{{ .logging.prefix }}",
      "stdout": {{ .logging.stdout }},
      "syslog": {{ .logging.syslog }},
      "format": "{{ .logging.format }}"
    },
    "telemetry/logstash": {
      "enabled": true
    },
    "telemetry/metrics": {
      "collection_time": "{{ .metrics.collection_time }}",
      "proxy_disabled": false,
      "router_disabled": false,
      "backend_disabled": false,
      "endpoint_disabled": false,
      "listen_address": "{{ .metrics.listen_address }}"
    }
    {{- if .security_headers.enabled }},
    "security/http": {
      "content_type_nosniff": {{ .security_headers.content_type_nosniff }},
      "browser_xss_filter": {{ .security_headers.browser_xss_filter }},
      "frame_deny": {{ .security_headers.frame_deny }},
      "content_security_policy": "{{ .security_headers.content_security_policy }}",
      "referrer_policy": "{{ .security_headers.referrer_policy }}"
      {{- if not .tls.disabled }},
      "sts_seconds": {{ env "HSTS_SECONDS" | default .security_headers.hsts.seconds }},
      "sts_include_subdomains": {{ .security_headers.hsts.include_subdomains }},
      "sts_preload": {{ .security_headers.hsts.preload }}
      {{- end }}
    }
    {{- end }}
  },
  "endpoints": [
    {
      "endpoint": "/api/v1/example",
      "method": "GET",
      "// comment": "Endpoint protegido de ejemplo. Requiere JWT valido (Keycloak). El plugin jwt-headers inyecta x-user-*.",
      "output_encoding": "no-op",
      "input_headers": [
        "Accept",
        "Accept-Language",
        "Content-Type",
        "Authorization",
        "x-user-id",
        "x-org-id",
        "x-user-roles",
        "x-username",
        "x-ip",
        "Traceparent",
        "Tracestate",
        "X-Traceparent",
        "x-geo-country",
        "x-geo-city",
        "x-geo-latitude",
        "x-geo-longitude",
        "x-geo-ip"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/example",
          "method": "GET",
          "encoding": "no-op",
          "host": ["{{ env "EXAMPLE_HOST" | default .hosts.example }}"]
        }
      ]
    },
    {
      "endpoint": "/public/v1/health",
      "method": "GET",
      "// comment": "Endpoint publico de ejemplo. Sin autenticacion (cubierto por /public/* en jwt.skip_paths e ip_resolver.skip_paths).",
      "output_encoding": "no-op",
      "input_headers": [
        "Accept",
        "Accept-Language",
        "Content-Type",
        "Traceparent",
        "Tracestate"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/health",
          "method": "GET",
          "encoding": "no-op",
          "host": ["{{ env "EXAMPLE_HOST" | default .hosts.example }}"]
        }
      ]
    }
  ]
}
