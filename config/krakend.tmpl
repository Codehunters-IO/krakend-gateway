{{- $gtEnabled := eq (env "GATEWAY_TIMEOUT_ENABLED" | default (printf "%v" .gateway_timeout.enabled)) "true" -}}
{{- $alEnabled := eq (env "ACCEPT_LANGUAGE_ENABLED" | default (printf "%v" .accept_language.enabled)) "true" -}}
{{- $tcEnabled := eq (env "TRACE_CONTEXT_ENABLED" | default (printf "%v" .trace_context.enabled)) "true" -}}
{{- $irEnabled := eq (env "IP_RESOLVER_ENABLED" | default (printf "%v" .ip_resolver.enabled)) "true" -}}
{{- $jwtEnabled := eq (env "JWT_ENABLED" | default (printf "%v" .jwt.enabled)) "true" -}}
{{- $shEnabled := eq (env "SECURITY_HEADERS_ENABLED" | default (printf "%v" .security_headers.enabled)) "true" -}}
{
  "$schema": "https://www.krakend.io/schema/krakend.json",
  "version": 3,
  "name": "{{ .service.name }}",
  "port": {{ .service.port }},
  "timeout": "{{ .service.timeout }}",
  "cache_ttl": "{{ .service.cache_ttl }}",
  {{- if not .tls.disabled }}
  "tls": {
    "keys": {{ marshal .tls.keys }}
    {{- if .tls.min_version }},
    "min_version": "{{ .tls.min_version }}"
    {{- end }}
    {{- if .tls.max_version }},
    "max_version": "{{ .tls.max_version }}"
    {{- end }}
    {{- if .tls.enable_mtls }},
    "enable_mtls": {{ .tls.enable_mtls }}
    {{- end }}
    {{- if .tls.disable_system_ca_pool }},
    "disable_system_ca_pool": {{ .tls.disable_system_ca_pool }}
    {{- end }}
    {{- if .tls.ca_certs }},
    "ca_certs": {{ marshal .tls.ca_certs }}
    {{- end }}
  },
  {{- end }}
  "client_tls": {{ marshal .client_tls }},
  "plugin": {
    "pattern": ".so",
    "folder": "/opt/krakend/plugins/"
  },
  "extra_config": {
    "plugin/http-server": {
      "name": [
        {{- if $gtEnabled }}
        "krakend-gateway-timeout"{{ if or $alEnabled $tcEnabled $irEnabled $jwtEnabled }},{{ end }}
        {{- end }}
        {{- if $alEnabled }}
        "krakend-accept-language"{{ if or $tcEnabled $irEnabled $jwtEnabled }},{{ end }}
        {{- end }}
        {{- if $tcEnabled }}
        "krakend-trace-context"{{ if or $irEnabled $jwtEnabled }},{{ end }}
        {{- end }}
        {{- if $irEnabled }}
        "krakend-ip-resolver"{{ if $jwtEnabled }},{{ end }}
        {{- end }}
        {{- if $jwtEnabled }}
        "krakend-jwt-headers"
        {{- end }}
      ]
      {{- if or $gtEnabled $alEnabled $irEnabled $jwtEnabled }},{{ end }}
      {{- if $gtEnabled }}
      "krakend-gateway-timeout": {
        "trigger_status": {{ .gateway_timeout.trigger_status }},
        "timeout_status": {{ .gateway_timeout.timeout_status }},
        "min_elapsed": "{{ env "GATEWAY_TIMEOUT_MIN_ELAPSED" | default .gateway_timeout.min_elapsed }}"
      }{{ if or $alEnabled $irEnabled $jwtEnabled }},{{ end }}
      {{- end }}
      {{- if $alEnabled }}
      "krakend-accept-language": {
        "default_value": "{{ .accept_language.default_value }}"
      }{{ if or $irEnabled $jwtEnabled }},{{ end }}
      {{- end }}
      {{- if $irEnabled }}
      "krakend-ip-resolver": {
        "api_base_url": "{{ .ip_resolver.api_base_url }}",
        "cache_ttl_minutes": {{ .ip_resolver.cache_ttl_minutes }},
        "skip_paths": {{ marshal .ip_resolver.skip_paths }}
      }{{ if $jwtEnabled }},{{ end }}
      {{- end }}
      {{- if $jwtEnabled }}
      "krakend-jwt-headers": {
        "jwks_url": "{{ .jwt.jwks_url }}",
        "issuer": "{{ .jwt.issuer }}",
        "cache_ttl_minutes": {{ .jwt.cache_ttl_minutes }},
        "claims_to_headers": {{ marshal .jwt.claims_to_headers }},
        "skip_paths": {{ marshal .jwt.skip_paths }},
        "required_claims": {{ marshal .jwt.required_claims }},
        "roles_claim": "{{ .jwt.roles_claim }}",
        "required_roles": {{ marshal .jwt.required_roles }},
        "add_ip_header": {{ .jwt.add_ip_header }},
        "ip_header_name": "{{ .jwt.ip_header_name }}",
        "introspection_enabled": {{ .jwt.introspection_enabled }},
        "introspection_url": "{{ .jwt.introspection_url }}",
        "introspection_client_id": "{{ .jwt.introspection_client_id }}",
        "introspection_client_secret": "{{ env "JWT_INTROSPECTION_CLIENT_SECRET" | default "" }}",
        "introspection_cache_ttl_seconds": {{ .jwt.introspection_cache_ttl_seconds }}
      }
      {{- end }}
    },
    "security/cors": {
      "allow_origins": {{ marshal .cors.allow_origins }},
      "allow_methods": {{ marshal .cors.allow_methods }},
      "allow_headers": {{ marshal .cors.allow_headers }},
      "expose_headers": {{ marshal .cors.expose_headers }},
      "max_age": "{{ .cors.max_age }}",
      "allow_credentials": {{ marshal .cors.allow_credentials }}
    },
    "qos/ratelimit/service": {
      "max_rate": {{ .rate_limit.service_max_rate }},
      "client_max_rate": {{ .rate_limit.service_client_max_rate }},
      "strategy": "{{ .rate_limit.strategy }}"
    },
    "telemetry/gologging": {
      "level": "{{ env "LOG_LEVEL" | default .logging.level }}",
      "prefix": "{{ .logging.prefix }}",
      "stdout": {{ .logging.stdout }},
      "syslog": {{ .logging.syslog }},
      "format": "{{ .logging.format }}"
    },
    "telemetry/logstash": {
      "enabled": true
    },
    "telemetry/metrics": {
      "collection_time": "{{ .metrics.collection_time }}",
      "proxy_disabled": false,
      "router_disabled": false,
      "backend_disabled": false,
      "endpoint_disabled": false,
      "listen_address": "{{ .metrics.listen_address }}"
    }
    {{- if $shEnabled }},
    "security/http": {
      "content_type_nosniff": {{ .security_headers.content_type_nosniff }},
      "browser_xss_filter": {{ .security_headers.browser_xss_filter }},
      "frame_deny": {{ .security_headers.frame_deny }},
      "content_security_policy": "{{ .security_headers.content_security_policy }}",
      "referrer_policy": "{{ .security_headers.referrer_policy }}"
      {{- if not .tls.disabled }},
      "sts_seconds": {{ env "HSTS_SECONDS" | default .security_headers.hsts.seconds }},
      "sts_include_subdomains": {{ .security_headers.hsts.include_subdomains }},
      "sts_preload": {{ .security_headers.hsts.preload }}
      {{- end }}
    }
    {{- end }}
  },
  "endpoints": [
    {
      "endpoint": "/api/ping",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [ "Accept", "Content-Type", "Traceparent", "Tracestate" ],
      "backend": [
        { "url_pattern": "/api/ping", "method": "GET", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"] }
      ]
    },
    {
      "endpoint": "/api/organizations",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [ "Accept","Accept-Language","Content-Type","Authorization","x-user-id","x-user-roles","x-username","x-org-slug","X-Organization-Id","x-ip","Idempotency-Key","Traceparent","Tracestate","X-Traceparent" ],
      "backend": [
        { "url_pattern": "/api/organizations", "method": "GET", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"] }
      ]
    }
,
    {
      "endpoint": "/api/organizations",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [ "Accept","Accept-Language","Content-Type","Authorization","x-user-id","x-user-roles","x-username","x-org-slug","X-Organization-Id","x-ip","Idempotency-Key","Traceparent","Tracestate","X-Traceparent" ],
      "backend": [
        { "url_pattern": "/api/organizations", "method": "POST", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"] }
      ]
    }
,
    {
      "endpoint": "/api/organizations/{orgId}/members",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [ "Accept","Accept-Language","Content-Type","Authorization","x-user-id","x-user-roles","x-username","x-org-slug","X-Organization-Id","x-ip","Idempotency-Key","Traceparent","Tracestate","X-Traceparent" ],
      "backend": [
        { "url_pattern": "/api/organizations/{orgId}/members", "method": "GET", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"] }
      ]
    }
,
    {
      "endpoint": "/api/projects",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [ "Accept","Accept-Language","Content-Type","Authorization","x-user-id","x-user-roles","x-username","x-org-slug","X-Organization-Id","x-ip","Idempotency-Key","Traceparent","Tracestate","X-Traceparent" ],
      "backend": [
        { "url_pattern": "/api/projects", "method": "GET", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"] }
      ]
    }
,
    {
      "endpoint": "/api/projects",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [ "Accept","Accept-Language","Content-Type","Authorization","x-user-id","x-user-roles","x-username","x-org-slug","X-Organization-Id","x-ip","Idempotency-Key","Traceparent","Tracestate","X-Traceparent" ],
      "backend": [
        { "url_pattern": "/api/projects", "method": "POST", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"] }
      ]
    }
,
    {
      "endpoint": "/api/projects/{projectId}/hub",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [ "Accept","Accept-Language","Content-Type","Authorization","x-user-id","x-user-roles","x-username","x-org-slug","X-Organization-Id","x-ip","Idempotency-Key","Traceparent","Tracestate","X-Traceparent" ],
      "backend": [
        { "url_pattern": "/api/projects/{projectId}/hub", "method": "GET", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"] }
      ]
    }
,
    {
      "endpoint": "/api/projects/{projectId}/summary",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [ "Accept","Accept-Language","Content-Type","Authorization","x-user-id","x-user-roles","x-username","x-org-slug","X-Organization-Id","x-ip","Idempotency-Key","Traceparent","Tracestate","X-Traceparent" ],
      "backend": [
        { "url_pattern": "/api/projects/{projectId}/summary", "method": "GET", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"] }
      ]
    }
,
    {
      "endpoint": "/api/projects/{projectId}/description",
      "method": "PUT",
      "output_encoding": "no-op",
      "input_headers": [ "Accept","Accept-Language","Content-Type","Authorization","x-user-id","x-user-roles","x-username","x-org-slug","X-Organization-Id","x-ip","Idempotency-Key","Traceparent","Tracestate","X-Traceparent" ],
      "backend": [
        { "url_pattern": "/api/projects/{projectId}/description", "method": "PUT", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"] }
      ]
    }
,
    {
      "endpoint": "/api/projects/{projectId}/stories",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [ "Accept","Accept-Language","Content-Type","Authorization","x-user-id","x-user-roles","x-username","x-org-slug","X-Organization-Id","x-ip","Idempotency-Key","Traceparent","Tracestate","X-Traceparent" ],
      "backend": [
        { "url_pattern": "/api/projects/{projectId}/stories", "method": "GET", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"] }
      ]
    }
,
    {
      "endpoint": "/api/projects/{projectId}/stories",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [ "Accept","Accept-Language","Content-Type","Authorization","x-user-id","x-user-roles","x-username","x-org-slug","X-Organization-Id","x-ip","Idempotency-Key","Traceparent","Tracestate","X-Traceparent" ],
      "backend": [
        { "url_pattern": "/api/projects/{projectId}/stories", "method": "POST", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"] }
      ]
    }
,
    {
      "endpoint": "/api/projects/{projectId}/board",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [ "Accept","Accept-Language","Content-Type","Authorization","x-user-id","x-user-roles","x-username","x-org-slug","X-Organization-Id","x-ip","Idempotency-Key","Traceparent","Tracestate","X-Traceparent" ],
      "backend": [
        { "url_pattern": "/api/projects/{projectId}/board", "method": "GET", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"] }
      ]
    }
,
    {
      "endpoint": "/api/projects/{projectId}/refinement/turns",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [ "Accept","Accept-Language","Content-Type","Authorization","x-user-id","x-user-roles","x-username","x-org-slug","X-Organization-Id","x-ip","Idempotency-Key","Traceparent","Tracestate","X-Traceparent" ],
      "backend": [
        { "url_pattern": "/api/projects/{projectId}/refinement/turns", "method": "GET", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"] }
      ]
    }
,
    {
      "endpoint": "/api/projects/{projectId}/refinement/turns",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [ "Accept","Accept-Language","Content-Type","Authorization","x-user-id","x-user-roles","x-username","x-org-slug","X-Organization-Id","x-ip","Idempotency-Key","Traceparent","Tracestate","X-Traceparent" ],
      "backend": [
        { "url_pattern": "/api/projects/{projectId}/refinement/turns", "method": "POST", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"] }
      ]
    }
,
    {
      "endpoint": "/api/stories/{id}",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [ "Accept","Accept-Language","Content-Type","Authorization","x-user-id","x-user-roles","x-username","x-org-slug","X-Organization-Id","x-ip","Idempotency-Key","Traceparent","Tracestate","X-Traceparent" ],
      "backend": [
        { "url_pattern": "/api/stories/{id}", "method": "GET", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"] }
      ]
    }
,
    {
      "endpoint": "/api/projects/{projectId}/refinement/stream",
      "method": "GET",
      "// comment": "SSE stream — no-op passthrough, timeout 3600s so the progress stream survives the 3s service timeout.",
      "output_encoding": "no-op",
      "timeout": "3600s",
      "input_headers": [ "Accept","Accept-Language","Content-Type","Authorization","x-user-id","x-user-roles","x-username","x-org-slug","X-Organization-Id","x-ip","Idempotency-Key","Traceparent","Tracestate","X-Traceparent" ],
      "backend": [
        { "url_pattern": "/api/projects/{projectId}/refinement/stream", "method": "GET", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"], "disable_host_sanitize": true }
      ]
    }
,
    {
      "endpoint": "/api/stories/{id}/refinement/stream",
      "method": "GET",
      "// comment": "SSE stream — no-op passthrough, timeout 3600s so the progress stream survives the 3s service timeout.",
      "output_encoding": "no-op",
      "timeout": "3600s",
      "input_headers": [ "Accept","Accept-Language","Content-Type","Authorization","x-user-id","x-user-roles","x-username","x-org-slug","X-Organization-Id","x-ip","Idempotency-Key","Traceparent","Tracestate","X-Traceparent" ],
      "backend": [
        { "url_pattern": "/api/stories/{id}/refinement/stream", "method": "GET", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"], "disable_host_sanitize": true }
      ]
    }
,
    {
      "endpoint": "/api/agent-runs/{id}/stream",
      "method": "GET",
      "// comment": "SSE stream — no-op passthrough, timeout 3600s so the progress stream survives the 3s service timeout.",
      "output_encoding": "no-op",
      "timeout": "3600s",
      "input_headers": [ "Accept","Accept-Language","Content-Type","Authorization","x-user-id","x-user-roles","x-username","x-org-slug","X-Organization-Id","x-ip","Idempotency-Key","Traceparent","Tracestate","X-Traceparent" ],
      "backend": [
        { "url_pattern": "/api/agent-runs/{id}/stream", "method": "GET", "encoding": "no-op", "host": ["{{ env "FORGEOS_HOST" | default .hosts.forgeos }}"], "disable_host_sanitize": true }
      ]
    }
  ]
}
