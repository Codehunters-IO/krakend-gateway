{{- $gtEnabled := eq (env "GATEWAY_TIMEOUT_ENABLED" | default (printf "%v" .gateway_timeout.enabled)) "true" -}}
{{- $alEnabled := eq (env "ACCEPT_LANGUAGE_ENABLED" | default (printf "%v" .accept_language.enabled)) "true" -}}
{{- $tcEnabled := eq (env "TRACE_CONTEXT_ENABLED" | default (printf "%v" .trace_context.enabled)) "true" -}}
{{- $irEnabled := eq (env "IP_RESOLVER_ENABLED" | default (printf "%v" .ip_resolver.enabled)) "true" -}}
{{- $jwtEnabled := eq (env "JWT_ENABLED" | default (printf "%v" .jwt.enabled)) "true" -}}
{{- $sessEnabled := eq (env "SESSION_ENABLED" | default (printf "%v" .session.enabled)) "true" -}}
{{- $shEnabled := eq (env "SECURITY_HEADERS_ENABLED" | default (printf "%v" .security_headers.enabled)) "true" -}}
{
  "$schema": "https://www.krakend.io/schema/krakend.json",
  "version": 3,
  "name": "{{ .service.name }}",
  "port": {{ .service.port }},
  "timeout": "{{ .service.timeout }}",
  "cache_ttl": "{{ .service.cache_ttl }}",
  {{- if not .tls.disabled }}
  "tls": {
    "keys": {{ marshal .tls.keys }}
    {{- if .tls.min_version }},
    "min_version": "{{ .tls.min_version }}"
    {{- end }}
    {{- if .tls.max_version }},
    "max_version": "{{ .tls.max_version }}"
    {{- end }}
    {{- if .tls.enable_mtls }},
    "enable_mtls": {{ .tls.enable_mtls }}
    {{- end }}
    {{- if .tls.disable_system_ca_pool }},
    "disable_system_ca_pool": {{ .tls.disable_system_ca_pool }}
    {{- end }}
    {{- if .tls.ca_certs }},
    "ca_certs": {{ marshal .tls.ca_certs }}
    {{- end }}
  },
  {{- end }}
  "client_tls": {{ marshal .client_tls }},
  "plugin": {
    "pattern": ".so",
    "folder": "/opt/krakend/plugins/"
  },
  "extra_config": {
    "plugin/http-server": {
      {{/* KrakenD's plugin/http-server executes plugins in the REVERSE of
           their declared order: each entry wraps the ones declared before
           it, so for name:[A,B,C] the composition is C(B(A(router))) — C
           (declared LAST) runs FIRST, A (declared first) runs last, closest
           to the router. Confirmed empirically in this repo, not just cited
           from docs (see the chain-order section of docs/session-flow.md
           for the A/B evidence): declaring this array in chain order
           (session-resolver before jwt-headers, as written) made
           jwt-headers execute FIRST and reject every cookie-only request
           before session-resolver ever saw it — silently, since krakend
           check still says "Syntax OK!" and every plugin still logs
           "plugin loaded". This array is declared in the REVERSE of the
           intended request-time chain (jwt-headers first, gateway-timeout
           last) so the actual execution order matches: gateway-timeout ->
           accept-language -> trace-context -> ip-resolver ->
           session-resolver -> jwt-headers. If you touch this array, keep it
           reversed and re-run the seeded-session check in
           docs/session-flow.md afterward. */}}
      "name": [
        {{- if $jwtEnabled }}
        "krakend-jwt-headers"{{ if or $sessEnabled $irEnabled $tcEnabled $alEnabled $gtEnabled }},{{ end }}
        {{- end }}
        {{- if $sessEnabled }}
        "krakend-session-resolver"{{ if or $irEnabled $tcEnabled $alEnabled $gtEnabled }},{{ end }}
        {{- end }}
        {{- if $irEnabled }}
        "krakend-ip-resolver"{{ if or $tcEnabled $alEnabled $gtEnabled }},{{ end }}
        {{- end }}
        {{- if $tcEnabled }}
        "krakend-trace-context"{{ if or $alEnabled $gtEnabled }},{{ end }}
        {{- end }}
        {{- if $alEnabled }}
        "krakend-accept-language"{{ if $gtEnabled }},{{ end }}
        {{- end }}
        {{- if $gtEnabled }}
        "krakend-gateway-timeout"
        {{- end }}
      ]
      {{- if or $gtEnabled $alEnabled $irEnabled $sessEnabled $jwtEnabled }},{{ end }}
      {{- if $gtEnabled }}
      "krakend-gateway-timeout": {
        "trigger_status": {{ .gateway_timeout.trigger_status }},
        "timeout_status": {{ .gateway_timeout.timeout_status }},
        "min_elapsed": "{{ env "GATEWAY_TIMEOUT_MIN_ELAPSED" | default .gateway_timeout.min_elapsed }}"
      }{{ if or $alEnabled $irEnabled $sessEnabled $jwtEnabled }},{{ end }}
      {{- end }}
      {{- if $alEnabled }}
      "krakend-accept-language": {
        "default_value": "{{ .accept_language.default_value }}"
      }{{ if or $irEnabled $sessEnabled $jwtEnabled }},{{ end }}
      {{- end }}
      {{- if $irEnabled }}
      "krakend-ip-resolver": {
        "api_base_url": "{{ .ip_resolver.api_base_url }}",
        "cache_ttl_minutes": {{ .ip_resolver.cache_ttl_minutes }},
        "skip_paths": {{ marshal .ip_resolver.skip_paths }}
      }{{ if or $sessEnabled $jwtEnabled }},{{ end }}
      {{- end }}
      {{- if $sessEnabled }}
      "krakend-session-resolver": {
        "valkey_addr": "{{ env "VALKEY_ADDR" | default .session.valkey_addr }}",
        "valkey_password": "{{ env "VALKEY_PASSWORD" | default "" }}",
        "valkey_db": {{ .session.valkey_db }},
        "valkey_timeout_ms": {{ .session.valkey_timeout_ms }},
        "key_prefix": "{{ .session.key_prefix }}",
        "cookie_name": "{{ env "SESSION_COOKIE_NAME" | default .session.cookie_name }}",
        "idle_ttl_seconds": {{ .session.idle_ttl_seconds }},
        "refresh_threshold_seconds": {{ .session.refresh_threshold_seconds }},
        "refresh_url": "{{ env "AUTH_BFF_REFRESH_URL" | default .session.refresh_url }}",
        "refresh_timeout_ms": {{ .session.refresh_timeout_ms }},
        "refresh_lock_ttl_seconds": {{ .session.refresh_lock_ttl_seconds }},
        "internal_secret": "{{ env "INTERNAL_SHARED_SECRET" | default "" }}",
        "allowed_origins": {{ env "SESSION_ALLOWED_ORIGINS" | default (join "," .session.allowed_origins) | splitList "," | marshal }},
        "csrf_safe_methods": {{ marshal .session.csrf_safe_methods }},
        {{/* skip_paths is DERIVED from the same endpoint spec jwt-headers
             derives its own from (see the block below), plus whatever extra
             literals session.json lists. Hand-maintaining a second list here
             meant the two adjacent plugins could silently disagree about
             which paths are public: the first public endpoint added outside
             /auth/ would keep its jwt-headers exemption but lose its
             session-resolver one, and a browser carrying a stale cookie
             would get a 401 on a route that is supposed to be open, with
             nothing going red. One source of truth instead:
             endpoints.yaml -> endpoints.json -> both plugins. */}}
        {{- $sessionSkip := .session.skip_paths }}
        {{- range .endpoints.endpoints }}{{ if eq .auth "public" }}{{ $sessionSkip = append $sessionSkip (regexReplaceAll "\\{[^}]+\\}" .path "*") }}{{ end }}{{ end }}
        "skip_paths": {{ marshal $sessionSkip }}
      }{{ if $jwtEnabled }},{{ end }}
      {{- end }}
      {{- if $jwtEnabled }}
      "krakend-jwt-headers": {
        "jwks_url": "{{ .jwt.jwks_url }}",
        "issuer": "{{ .jwt.issuer }}",
        "cache_ttl_minutes": {{ .jwt.cache_ttl_minutes }},
        "claims_to_headers": {{ marshal .jwt.claims_to_headers }},
        "skip_paths": [
          {{- range $i, $p := .jwt.skip_paths }}{{ if $i }},{{ end }}"{{ $p }}"{{ end }}
          {{- range .endpoints.endpoints }}{{ if eq .auth "public" }},"{{ regexReplaceAll "\\{[^}]+\\}" .path "*" }}"{{ end }}{{ end }}
        ],
        "required_claims": {{ marshal .jwt.required_claims }},
        "roles_claim": "{{ .jwt.roles_claim }}",
        "required_roles": {{ marshal .jwt.required_roles }},
        "add_ip_header": {{ .jwt.add_ip_header }},
        "ip_header_name": "{{ .jwt.ip_header_name }}",
        "introspection_enabled": {{ .jwt.introspection_enabled }},
        "introspection_url": "{{ .jwt.introspection_url }}",
        "introspection_client_id": "{{ .jwt.introspection_client_id }}",
        "introspection_client_secret": "{{ env "JWT_INTROSPECTION_CLIENT_SECRET" | default "" }}",
        "introspection_cache_ttl_seconds": {{ .jwt.introspection_cache_ttl_seconds }}
      }
      {{- end }}
    },
    "security/cors": {
      "allow_origins": {{ env "CORS_ALLOW_ORIGINS" | default (join "," .cors.allow_origins) | splitList "," | marshal }},
      "allow_methods": {{ marshal .cors.allow_methods }},
      "allow_headers": {{ marshal .cors.allow_headers }},
      "expose_headers": {{ marshal .cors.expose_headers }},
      "max_age": "{{ .cors.max_age }}",
      "allow_credentials": {{ marshal .cors.allow_credentials }}
    },
    "qos/ratelimit/service": {
      "max_rate": {{ .rate_limit.service_max_rate }},
      "client_max_rate": {{ .rate_limit.service_client_max_rate }},
      "strategy": "{{ .rate_limit.strategy }}"
    },
    "telemetry/gologging": {
      "level": "{{ env "LOG_LEVEL" | default .logging.level }}",
      "prefix": "{{ .logging.prefix }}",
      "stdout": {{ .logging.stdout }},
      "syslog": {{ .logging.syslog }},
      "format": "{{ .logging.format }}"
    },
    "telemetry/logstash": {
      "enabled": true
    },
    "telemetry/metrics": {
      "collection_time": "{{ .metrics.collection_time }}",
      "proxy_disabled": false,
      "router_disabled": false,
      "backend_disabled": false,
      "endpoint_disabled": false,
      "listen_address": "{{ .metrics.listen_address }}"
    }
    {{- if $shEnabled }},
    "security/http": {
      "content_type_nosniff": {{ .security_headers.content_type_nosniff }},
      "browser_xss_filter": {{ .security_headers.browser_xss_filter }},
      "frame_deny": {{ .security_headers.frame_deny }},
      "content_security_policy": "{{ .security_headers.content_security_policy }}",
      "referrer_policy": "{{ .security_headers.referrer_policy }}"
      {{- if not .tls.disabled }},
      "sts_seconds": {{ env "HSTS_SECONDS" | default .security_headers.hsts.seconds }},
      "sts_include_subdomains": {{ .security_headers.hsts.include_subdomains }},
      "sts_preload": {{ .security_headers.hsts.preload }}
      {{- end }}
    }
    {{- end }}
  },
  "endpoints": [
{{- range $i, $e := .endpoints.endpoints }}
  {{- if $i }},{{ end }}
    {
      "endpoint": "{{ $e.path }}",
      "method": "{{ $e.method }}",
      "output_encoding": "{{ $e.output_encoding }}",
      "input_headers": {{ marshal $e.input_headers }},
      {{- if $e.input_query_strings }}
      "input_query_strings": {{ marshal $e.input_query_strings }},
      {{- end }}
      {{- if $e.timeout }}
      "timeout": "{{ $e.timeout }}",
      {{- end }}
      {{- if $e.rate_limit }}
      "extra_config": { "qos/ratelimit/router": {{ marshal $e.rate_limit }} },
      {{- end }}
      "backend": [
        {
          "url_pattern": "{{ $e.url_pattern }}",
          "method": "{{ $e.method }}",
          "encoding": "{{ $e.encoding }}",
          {{- if $e.disable_host_sanitize }}
          "disable_host_sanitize": true,
          {{- end }}
          "host": ["{{ env $e.host_env | default $e.host_default }}"]
        }
      ]
    }
{{- end }}
  ]
}
