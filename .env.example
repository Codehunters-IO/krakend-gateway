# Plantilla de entorno para docker-compose. Copiar y rellenar:
#
#   cp .env.example .env
#
# .env esta en .gitignore: es donde viven los valores reales, y no se versiona.
# Este fichero solo documenta. No poner secretos de produccion aqui.
#
# Las variables sin valor por defecto en docker-compose.yml usan `:?`, asi que
# compose falla al arrancar si faltan. Es deliberado: un secreto ausente tiene
# que parar el arranque, no quedarse en un default conocido.

# ---------------------------------------------------------------------------
# Obligatorias — compose no arranca sin ellas
# ---------------------------------------------------------------------------

# Secreto que session-resolver presenta al endpoint /internal de auth-bff.
# Ambos lados tienen que compartir el mismo valor.
INTERNAL_SHARED_SECRET=cambiar-en-cada-entorno

# Contrasena de Valkey. La usan el servidor, su healthcheck y session-resolver,
# que leen la misma variable. En desarrollo cualquier valor sirve; en produccion
# sale del gestor de secretos, nunca de este fichero.
VALKEY_PASSWORD=devpassword

# ---------------------------------------------------------------------------
# Backends — vacio usa el host_default declarado en endpoints.yaml
# ---------------------------------------------------------------------------

#AUTH_BFF_HOST=http://host.docker.internal:8086

# ---------------------------------------------------------------------------
# Keycloak — issuer tiene que ser identico al claim `iss` del token
# ---------------------------------------------------------------------------

# KEYCLOAK_JWKS_URL se resuelve desde dentro del contenedor, KEYCLOAK_ISSUER se
# compara con el token tal cual lo emitio el realm. Por eso uno puede llevar
# host.docker.internal y el otro localhost: son dos puntos de vista distintos.
#KEYCLOAK_ISSUER=http://localhost:8083/realms/forgeos
#KEYCLOAK_JWKS_URL=http://host.docker.internal:8083/realms/forgeos/protocol/openid-connect/certs

# Secreto de cliente para introspeccion (RFC 7662), el unico mecanismo que
# detecta un token revocado. Solo se usa si introspection_enabled esta en true
# en config/settings/jwt.json, que hoy esta en false. Si se enciende, jwt-headers
# exige client_id y client_secret y se niega a cargar sin ellos: su camino de
# error admite el token para sobrevivir a una caida de Keycloak, y con
# credenciales vacias esa tolerancia dejaria la revocacion apagada en silencio.
#JWT_INTROSPECTION_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Sesion (session-resolver)
# ---------------------------------------------------------------------------

#SESSION_ENABLED=
#VALKEY_ADDR=valkey:6379
#VALKEY_USERNAME=
#SESSION_COOKIE_NAME=sid
#AUTH_BFF_REFRESH_URL=http://host.docker.internal:8086/internal/sessions/{sid}/refresh
#SESSION_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Feature-flags de plugins y modulos
# ---------------------------------------------------------------------------

# Vacio = manda el "enabled" del JSON en config/settings/. "true"/"false"
# fuerzan el override en cualquier direccion.
#JWT_ENABLED=
#SECURITY_HEADERS_ENABLED=
#GATEWAY_TIMEOUT_ENABLED=
#ACCEPT_LANGUAGE_ENABLED=
#TRACE_CONTEXT_ENABLED=

# JWT_ROLES_ENFORCE=false hace que jwt-headers registre lo que denegaria en vez
# de denegarlo. Es el paso de observacion del despliegue de roles por app;
# cualquier otro valor, incluido vacio, aplica.
#JWT_ROLES_ENFORCE=

# ---------------------------------------------------------------------------
# Otros overrides del template
# ---------------------------------------------------------------------------

#LOG_LEVEL=
#CORS_ALLOW_ORIGINS=
#HSTS_SECONDS=
#GATEWAY_TIMEOUT_MIN_ELAPSED=
