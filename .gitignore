# Generated KrakenD config
krakend.json
/tmp/

# Compiled plugins (architecture-specific, built via make plugin-build)
plugins/build/*.so

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.cursor/


# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Local environment values. The README asks for a .env next to
# docker-compose.yml; .env.example is the versioned template.
.env
.env.*
!.env.example

# TLS certs (mount target only — never commit real certs/keys)
certs/*
!certs/.gitkeep
certs/*.key
certs/*.crt

# Compiled plugin binaries (core dumps / build artifacts)
plugins/*/core
plugins/build/
*.so

# Transient render written by scripts/check-plugin-chain-order.sh
.krakend-chain-order.*
